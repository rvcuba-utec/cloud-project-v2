# Copiar a config.env (fuera de Git).
STAGE=dev
REGION=us-east-1
# Organización de Serverless Framework
SLS_ORG=cambiar-por-tu-org
# En app.serverless.com: Settings > Access Keys. Evita el login por navegador.
SERVERLESS_ACCESS_KEY=

# El navegador y los servicios usan un único API Gateway REST por ambiente (HTTPS en execute-api).
# API Gateway invoca directamente a cada Lambda: no hay VPC, VPC Link ni ALB.
