# Copiar a config.env (fuera de Git).
STAGE=dev
REGION=us-east-1
# Organización de Serverless Framework
SLS_ORG=cambiar-por-tu-org
# En app.serverless.com: Settings > Access Keys. Evita el login por navegador.
SERVERLESS_ACCESS_KEY=

# El navegador se conecta por HTTPS al dominio execute-api de API Gateway.
# En AWS Academy, VPC Link V2 llega por HTTP/80 a un ALB INTERNO; no requiere ACM.
# El tráfico del tramo privado NO tiene TLS. No usar secretos reales en este entorno.
# Opcional fuera de us-east-1. Seleccionar dos zonas que admitan VPC Link V2.
TRAZORA_AZ_ID_A=
TRAZORA_AZ_ID_B=
