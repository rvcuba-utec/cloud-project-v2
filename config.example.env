# Copiar a config.env (fuera de Git).
STAGE=dev
REGION=us-east-1
# Organización de Serverless Framework
SLS_ORG=cambiar-por-tu-org
# En app.serverless.com: Settings > Access Keys. Evita el login por navegador.
SERVERLESS_ACCESS_KEY=

# Ingreso HTTPS privado. Usar el ARN de ACM en la región del stack y un nombre cubierto por el certificado.
TRAZORA_ALB_CERT_ARN_DEV=
TRAZORA_ALB_DOMINIO_DEV=
TRAZORA_ALB_CERT_ARN_TEST=
TRAZORA_ALB_DOMINIO_TEST=
TRAZORA_ALB_CERT_ARN_PROD=
TRAZORA_ALB_DOMINIO_PROD=
# Opcional fuera de us-east-1. Seleccionar dos zonas que admitan VPC Link V2.
TRAZORA_AZ_ID_A=
TRAZORA_AZ_ID_B=
